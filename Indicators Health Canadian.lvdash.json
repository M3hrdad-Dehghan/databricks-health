{
  "datasets": [
    {
      "name": "ca000c71",
      "displayName": "health",
      "queryLines": [
        "SELECT y.year, g.geography, i.indicator, d.age_group, d.sex,\r\n",
        "       ROUND(f.value, 1) AS percent\r\n",
        "FROM workspace.dev_gold.fact_health_indicator f\r\n",
        "JOIN workspace.dev_gold.dim_geography   g ON f.geo_key = g.geo_key\r\n",
        "JOIN workspace.dev_gold.dim_indicator   i ON f.indicator_key = i.indicator_key\r\n",
        "JOIN workspace.dev_gold.dim_measure     m ON f.measure_key = m.measure_key\r\n",
        "JOIN workspace.dev_gold.dim_demographic d ON f.demo_key = d.demo_key\r\n",
        "JOIN workspace.dev_gold.dim_year        y ON f.year = y.year\r\n",
        "WHERE m.characteristic LIKE 'Percent%'"
      ]
    }
  ],
